FRONTEND_ORIGINS=http://127.0.0.1:5173,https://your-frontend-domain.example
AI_PROVIDER=openrouter
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_VISION_ENABLED=true
OPENAI_VISION_MODEL=gpt-4o
OPENAI_SMART_CLASSIFIER_ENABLED=true
OPENAI_CLASSIFIER_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=MacroByte BK Tool

FEEDBACK_TO_EMAIL=your-email@example.com
FEEDBACK_SUBJECT_PREFIX=MacroByte BK Tool Feedback

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_FROM_EMAIL=your-email@example.com
