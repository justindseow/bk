{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/*.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/app.py"
    },
    {
      "source": "/export/(.*)",
      "destination": "/api/app.py"
    },
    {
      "source": "/intake/(.*)",
      "destination": "/api/app.py"
    },
    {
      "source": "/intake-json/(.*)",
      "destination": "/api/app.py"
    },
    {
      "source": "/feedback",
      "destination": "/api/app.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
